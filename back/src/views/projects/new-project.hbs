<form id="project-form" class="project_form">
  <div class="project-form__title">
    <label for="project_title">Title</label>
    <input
      type="text"
      name="title"
      id="project_title"
      placeholder="Project Title"
    />
  </div>
  <div class="project-form__slug">
    <label for="project_slug">Slug</label>
    <input 
    type="text"
    name="slug"
    id="project_slug"
    value="slug">
  </div>
  <div class="project-form__description">
    <label for="project_description">Description</label>
    <textarea
      name="description"
      id="project_description"
      placeholder="Project Description"
      rows="20"
      cols="40"
    ></textarea>
  </div>
  <div class="project-form__link">
    <label for="project_link">Link</label>
    <input
      type="url"
      name="link"
      id="project_link"
      placeholder="https://project-link.com"
      value="https://"
    />
  </div>
  <div class="project-form__submit">
    <input type="submit" value="Save" class="btn" />
  </div>
</form>