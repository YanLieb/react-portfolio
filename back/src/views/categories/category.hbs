<form id="category_form" class="category-form-new">
  <div class="category-form__name mb-4">
    <label for="category_name">Name</label>
    <input 
      type="text" 
      name="name"
      id="category_name"
      palceholder="Category Name"
      required 
      {{#if category.name}}value="{{category.name}}"{{/if}}
    />
  </div>
    <div class="category-form__slug mb-4">
    <label for="category_slug">Slug</label>
    <input 
      type="text" 
      name="slug"
      id="category_slug"
      required 
      {{#if category.slug}}value="{{category.slug}}"{{/if}}
    />
  </div>
  <div class="cateogory-form__submit">
    <input type="submit" value="Save" class="btn">
  </div>
</form>