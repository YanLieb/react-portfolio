<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    {{#if styles}}
      <link rel="stylesheet" href="{{styles}}" class="css" />
    {{/if}}
    <title>{{title}}</title>
  </head>
  <body>
    {{> header}}

    <main>
      {{{body}}}
    </main>

    {{> footer}}

    {{#if scripts}}
    <script src="{{scripts}}" defer></script>
    {{/if}}
  </body>
</html>