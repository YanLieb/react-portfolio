html
  head
    title= "Project"
    script(src="/js/project-form.js" defer)
  body 
  header(class="header")
    h1= "Create a new project"
  
  form(id="project-form" class="project_form") 
    div(class="project-form__title")
      label(for="project_title")= "Titre"
      input(
        type="text"
        name="title"
        id="project_title"
        placeholder="Titre du projet"
      )
    div(class="project-form__description")
      label(for="project_description")= "Description"
      textarea(
        name="description"
        id="project_description"
        placeholder="Description du projet"
        rows="20"
        cols="40"
        )
    div(class="project-form__link")
      label(for="project_link")= "Lien"
      input(
        type="url"
        name="link"
        id="project_link"
      )
    div(class="project-form__submit")
      input(type="submit" value="Save")
